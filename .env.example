# --- Gemini (https://aistudio.google.com/apikey) ---
# Optional: the key can also be pasted in the web UI (API key panel).
# A key entered in the UI overrides this one.
GEMINI_API_KEY=

# Model that listens to the audio, identifies the bird and writes the prompt
GEMINI_AUDIO_MODEL=gemini-2.0-flash
# Model that generates the image (e.g. gemini-2.0-flash-exp or imagen-3.0-generate-002)
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp

MIN_CONFIDENCE=0.60
MAX_AUDIO_MB=15

# --- CORS: only needed if you serve frontend/ from a different origin ---
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
